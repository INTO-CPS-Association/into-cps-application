@startuml react_app_package
'Set the background to white
skinparam backgroundColor white
skinparam packageBackgroundColor white
skinparam rectangleBackgroundColor white
skinparam classBackgroundColor white
skinparam componentBackgroundColor white
skinparam noteBackgroundColor white
skinparam objectBackgroundColor white

'Set the border, arrow and text colors to black
skinparam packageBorderColor black
skinparam rectangleBorderColor black
skinparam classBorderColor black
skinparam componentBorderColor black
skinparam noteBorderColor black
skinparam objectBorderColor black
skinparam ArrowColor black
skinparam DefaultTextAlignment center
skinparam NoteFontColor black

'Font colors to black
skinparam ClassFontColor black
skinparam PackageFontColor black
skinparam DefaultFontColor black

!define RECTANGLE class

package "INTO-CPS React App" {

    ' -------------------
    ' Components
    ' -------------------
    package "Components" {
        class App {
            - darkMode: boolean
            - sidebarOpen: boolean
            - sidebarWidth: number
            + toggleSidebar(): void
            + toggleDarkMode(): void
            + handleResize(): void
            + handleToggleDarkMode(): void
            + handleError(errorMessage: string): void
        }

        class Sidebar {
            - isResponsive: boolean
            - manualOpen: boolean
            - width: number
            + handleResize(): void
            + handleToggle(): void
            + setWidth(width: number): void
        }

        class Main {
            + renderContent(): JSX.Element
        }

        class CoSimulation {
            - error: string | null
            - simulationStatus: string
            - resultsPath: string | null
            + startSimulation(): void
            + stopSimulation(): void
            + resetSimulation(): void
        }

        class ErrorSnackbar {
            - open: boolean
            - message: string
            - severity: 'info' | 'error' | 'warning' | 'success'
            + showError(message: string): void
            + close(): void
        }

        class LivePlotting {
            - data: DataMap
            - darkMode?: boolean
            - autoZoomEnd?: number | null
            + updateData(newData: DataMap): void
            + setAutoZoomEnd(value: number | null): void
        }
    }

    ' -------------------
    ' Hooks
    ' -------------------
    package "Hooks" {
        class useCosimulation {
            - error: string | null
            - simulationStatus: string
            - resultsPath: string | null
            + start(): void
            + stop(): void
            + reset(): void
        }

        class useLivePlotting {
            - data: DataMap
            - darkMode: boolean
            - autoZoomEnd: number | null
            + subscribe(callback): void
            + unsubscribe(callback): void
            + clearData(): void
        }
    }

    ' -------------------
    ' APIs
    ' -------------------
    package "APIs" {
        class cosimulationAPI {
            + maestro(args: { type: string, data?: unknown }): Promise<MaestroResponse>
            + onSimulationStatus(callback): void
            + removeSimulationStatusListener(callback): void
            + addCoeErrorListener(callback): void
            + removeCoeErrorListener(): void
            + addCoeResetListener(callback): void
            + removeCoeResetListener(): void
            + getConfig(): Promise<Config | null>
            + getLatestResultFolder(): Promise<string | null>
        }
    }

    ' -------------------
    ' Utilities
    ' -------------------
    package "Utilities" {
        class ErrorHandler {
            + handleError(error: unknown): void
            + sendNotification(message: string, type: string): void
        }

        class MaestroUtils {
            + getReadableTimestamp(): string
            + getJavaCommand(): string
        }
    }

    ' -------------------
    ' MaestroManager
    ' -------------------
    package "MaestroManager" {
        class MaestroManager {
            + startSimulation(): Promise<SimulationResult>
            + extractMaestroJar(): void
            + getLatestSimulationFolder(): string | null
        }
    }

    package "Menu"{
        class MenuManager {
            + updateCosimulationMenu(status: string): void
        }
    }
    ' -------------------
    ' Relationships
    ' -------------------
    App --> Sidebar : uses
    App --> Main : uses
    App --> CoSimulation : uses
    App --> LivePlotting : uses
    App --> ErrorSnackbar : uses

    CoSimulation --> useCosimulation : «hook»
    LivePlotting --> useLivePlotting : «hook»

    useCosimulation ..> cosimulationAPI : «listen»
    useLivePlotting ..> cosimulationAPI : «data via WS»

    ErrorSnackbar ..> cosimulationAPI : «error/notifications»

    cosimulationAPI --> MaestroManager : «invoke»
    cosimulationAPI --> ErrorHandler : «error handling»
    MaestroManager --> ErrorHandler : «error handling»
    MaestroManager --> Menu : «update menu»
    MaestroManager --> MaestroUtils : «timestamp/java detection»
}

@enduml
